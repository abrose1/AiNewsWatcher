# Twilio WhatsApp: both numbers need the `whatsapp:` prefix.
# Use bare phone numbers (no prefix) only if switching the channel to SMS.
TWILIO_FROM_NUMBER=whatsapp:+1...
SMS_TO_NUMBER=whatsapp:+1...
